# ==============================================================================
# NEXA STUDY AI — Environment Configuration Example
# Copy to .env and fill in your real credentials. NEVER commit .env to GitHub.
# ==============================================================================

# Telegram Bot Token from @BotFather (REQUIRED)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Local Ollama API URL
# - When running bot via Docker on network `nexa-net`: http://ollama:11434
# - When running bot directly on Ubuntu host (systemd/venv): http://127.0.0.1:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
# Optional direct Vision model for image questions (e.g. qwen2.5vl:3b or gemma3:4b).
# Leave empty to use fast Tesseract OCR + OLLAMA_MODEL; if set, falls back to Tesseract automatically on error.
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_THREADS=2
OLLAMA_NUM_CTX=2048
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_CONCURRENT=1

# External MongoDB Connection (e.g., MongoDB Atlas 500 MB Free Tier)
# Leave empty during Phase 1 testing to run with in-memory fallback.
MONGODB_URI=
MONGODB_DB_NAME=nexa_study_ai
MONGODB_TIMEOUT_MS=5000
QUESTION_TTL_DAYS=90

# Security & Rate Limiting
RATE_LIMIT_REQUESTS=8
RATE_LIMIT_WINDOW_SECONDS=60
MAX_INPUT_CHARS=1500
MAX_IMAGE_SIZE_MB=5

# OCR Configuration (Tesseract on ARM64)
OCR_MIN_CONFIDENCE=45.0
OCR_LANG=eng

# Telegram Bot API 9.4+ & 10.4+ Modern UI Features
ENABLE_COLORED_BUTTONS=true
ENABLE_PREMIUM_EMOJI=true
ENABLE_TELEGRAM_WIDGETS=true

# Optional: Custom Telegram Premium Emoji IDs for Inline Buttons (`icon_custom_emoji_id`)
# Requires the bot owner to have Telegram Premium (Bot API 9.4+) or a Fragment username.
# Leave blank to use built-in Unicode emoji gracefully without API errors.
PREMIUM_EMOJI_BIOLOGY=
PREMIUM_EMOJI_CHEMISTRY=
PREMIUM_EMOJI_PHYSICS=
PREMIUM_EMOJI_IMAGE=
PREMIUM_EMOJI_NCERT=
PREMIUM_EMOJI_PYQ=
PREMIUM_EMOJI_QUIZ=
PREMIUM_EMOJI_PROGRESS=
PREMIUM_EMOJI_SETTINGS=
PREMIUM_EMOJI_HELP=
PREMIUM_EMOJI_RANDOM=
PREMIUM_EMOJI_WIDGET=
PREMIUM_EMOJI_HOME=
PREMIUM_EMOJI_SPARK=
PREMIUM_EMOJI_CHECK=
PREMIUM_EMOJI_CANCEL=

# Runtime & Logging
LOCK_FILE_PATH=/tmp/nexa_study_ai.lock
LOG_LEVEL=INFO
